<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.msn.quartz.mapper.IQrtzSimpleTriggersMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="OriMap" type="com.iteaj.iboot.msn.quartz.entity.QrtzSimpleTriggers">
        <result column="REPEAT_COUNT" property="repeatCount" />
        <result column="REPEAT_INTERVAL" property="repeatInterval" />
        <result column="TIMES_TRIGGERED" property="timesTriggered" />
        <result column="TRIGGER_GROUP" property="triggerGroup" />
        <result column="TRIGGER_NAME" property="triggerName" />
    </resultMap>

    <!-- 表字段列表 -->
    <sql id="OriSql">
         a.REPEAT_COUNT, a.REPEAT_INTERVAL, a.SCHED_NAME, a.TIMES_TRIGGERED, a.TRIGGER_GROUP, a.TRIGGER_NAME
    </sql>
    <!-- 表字段关联列表 -->
    <sql id="OriJoinSql">
         qst.REPEAT_COUNT qst_REPEAT_COUNT, qst.REPEAT_INTERVAL qst_REPEAT_INTERVAL, qst.SCHED_NAME qst_SCHED_NAME, qst.TIMES_TRIGGERED qst_TIMES_TRIGGERED, qst.TRIGGER_GROUP qst_TRIGGER_GROUP, qst.TRIGGER_NAME qst_TRIGGER_NAME,

    </sql>

</mapper>
