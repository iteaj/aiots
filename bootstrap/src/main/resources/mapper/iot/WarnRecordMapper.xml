<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.module.iot.mapper.WarnRecordMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.module.iot.entity.WarnRecord">
        <result column="id" property="id" />
        <result column="uid" property="uid" />
        <result column="name" property="warnConfigName" />
        <result column="device_name" property="deviceName" />
        <result column="grade" property="grade" />
        <result column="content" property="content" />
        <result column="device_sn" property="deviceSn" />
        <result column="warn_config_id" property="warnConfigId" />
        <result column="warn_time" property="warnTime" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <select id="detailPage" resultMap="BaseResultMap">
        select a.*, c.name, c.grade, d.name device_name from iot_warn_record a
            left join iot_warn_config c on a.warn_config_id=c.id
            left join iot_device d on a.uid = d.uid
        <where>
            <if test="entity.grade != null">
                and c.grade = #{entity.grade}
            </if>
            <if test="entity.uid != null and entity.uid != ''">
                and a.uid = #{entity.uid}
            </if>
            <if test="entity.productId != null">
                and c.product_id = #{entity.productId}
            </if>
            <if test="entity.deviceName != null and entity.deviceName != ''">
                and d.name like '%${entity.deviceName}%'
            </if>
            <if test="entity.warnConfigName != null and entity.warnConfigName != ''">
                and c.name like '%${entity.warnConfigName}%'
            </if>
        </where>
        order by a.warn_time desc
    </select>

</mapper>
