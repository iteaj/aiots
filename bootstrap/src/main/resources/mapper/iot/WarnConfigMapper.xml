<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.module.iot.mapper.WarnConfigMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.module.iot.entity.WarnConfig">
        <result column="id" property="id" />
        <result column="name" property="name" />
        <result column="grade" property="grade" />
        <result column="remark" property="remark" />
        <result column="template" property="template" />
        <result column="frequency" property="frequency" />
        <result column="product_id" property="productId" />
        <result column="model_attr_field" property="modelAttrField" />
        <result column="model_attr_id" property="modelAttrId" />
        <result column="create_time" property="createTime" />
        <result column="message_template_id" property="messageTemplateId" />
        <result column="operator" property="operator" />
        <result column="threshold" property="threshold" />
        <result column="indicator" property="indicator" />
        <result column="config" property="config"
            typeHandler="com.iteaj.framework.mybatis.handler.FastjsonTypeHandler" />
    </resultMap>

    <select id="pageDetail" resultMap="BaseResultMap">
        select a.*, p.name product_name from iot_warn_config a
            left join iot_product p on a.product_id = p.id
            left join iot_product_type pt on p.product_type_id=pt.id
        <where>
            <choose>
                <when test="entity.grade != null">
                    and a.grade = #{entity.grade}
                </when>
                <otherwise>
                    and a.grade != 'indicator'
                </otherwise>
            </choose>

            <if test="entity.productId!=null">
                and a.product_id = #{entity.productId}
            </if>
            <if test="entity.name != null and entity.name !=''">
                and a.name like '%${entity.name}%'
            </if>
        </where>
        order by a.create_time desc
    </select>

    <select id="isBinded" resultType="java.lang.Boolean">
        select count(a.id) > 0 from iot_warn_config a
            inner join iot_linkage_action la on la.type='warn' and a.id=la.linked_id
        where a.id=#{id} limit 1
    </select>

</mapper>
