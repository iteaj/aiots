<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.module.iot.mapper.DeviceRealtimeCacheMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.module.iot.entity.DeviceRealtimeCache">
        <result column="id" property="id" />
        <result column="uid" property="uid" />
        <result column="field_id" property="fieldId" />
        <result column="field" property="field" />
        <result column="value" property="value" />
        <result column="collect_time" property="collectTime" />
    </resultMap>

    <insert id="cacheOrUpdate">
        insert into iot_realtime_cache(uid, field_id, field, `value`, collect_time)
        values
        <foreach collection="entities" separator="," item="item">
            (#{item.uid}, #{item.fieldId}, #{item.field}, #{item.value}, #{item.collectTime})
        </foreach>
        on duplicate key update
        field = values(field),
        `value` = values(`value`),
        collect_time = values(collect_time)
    </insert>

</mapper>
