<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.module.iot.mapper.LinkageActionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.module.iot.entity.LinkageAction">
        <result column="id" property="id" />
        <result column="uid" property="uid" />
        <result column="type" property="type" />
        <result column="device_name" property="deviceName" />
        <result column="product_id" property="productId" />
        <result column="product_name" property="productName" />
        <result column="linkage_id" property="linkageId" />
        <result column="linkage_item_id" property="linkageItemId" />
        <result column="linked_id" property="linkedId" />
        <result column="linked_name" property="linkedName" />
        <result column="model_api_code" property="modelApiCode" />
        <result column="type_name" property="typeName" />
    </resultMap>

    <select id="listByLinkageItemId" resultMap="BaseResultMap">
        select a.*, if(a.type='model', p.name, c.name) linked_name, p.name product_name, d.name device_name from iot_linkage_action a
            left join iot_product p on a.product_id=p.id
            left join iot_device d on a.uid=d.uid
            left join iot_model_api ma on ma.id=a.linked_id and a.type='model'
            left join iot_warn_config c on c.id=a.linked_id and a.type='warn'
        where a.linkage_item_id=#{linkageItemId}
    </select>
</mapper>
