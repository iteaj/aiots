<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>izone</artifactId>
        <groupId>com.iteaj</groupId>
        <version>1.1.4-SNAPSHOT</version>
    </parent>

    <name>boot:bootstrap</name>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>bootstrap</artifactId>

    <properties>
        <env.filter.file>../deploy/env/${profiles.active.env}.properties</env.filter.file>
    </properties>

    <dependencies>

        <!-- ####################################################### -->
        <!--                     后台管理模块 开始                      -->
        <!-- ####################################################### -->

        <dependency> <!-- 管理端 - 系统核心模块(必选) -->
            <groupId>com.iteaj</groupId>
            <artifactId>admin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency><!-- 管理端 - 开发模块(可选) -->
            <groupId>com.iteaj</groupId>
            <artifactId>develop</artifactId>
            <version>${project.version}</version>
        </dependency>


        <!-- ####################################################### -->
        <!--                     可选 plugins开始                      -->
        <!-- ####################################################### -->

        <dependency><!--  shiro 权限管理插件  -->
            <groupId>com.iteaj</groupId>
            <artifactId>shiro</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ####################################################### -->
        <!--                     可选 plugins 结束                    -->
        <!-- ####################################################### -->

        <!--启用缓存-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile><!-- 开发环境下引入开发模块 -->
            <id>env-dev</id>
            <dependencies>
                <dependency>
                    <groupId>com.iteaj</groupId>
                    <artifactId>develop</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
