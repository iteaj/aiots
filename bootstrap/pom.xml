        <!-- Quartz定时任务插件 -->
<!--        <dependency>-->
<!--            <groupId>com.iteaj</groupId>-->
<!--            <artifactId>iboot-quartz</artifactId>-->
<!--            <version>${project.version}</version>-->
<!--        </dependency>-->

        <!-- 消息源插件(短信, email, 钉钉...) -->
