<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.module.模块.mapper.XxxMapper">

    <!-- 实体映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.module.模块.entity.Xxx">
        <result column="id" property="id" />
        <result column="name" property="name" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- DTO 映射结果 -->
    <resultMap id="XxxDtoResultMap" type="com.iteaj.iboot.module.模块.dto.XxxDto" extends="BaseResultMap">
        <!-- dto额外字段映射结果 -->
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, create_time
    </sql>

    <!-- detailById 查询 -->
    <select id="detailById" resultMap="XxxDtoResultMap">
        SELECT 
        <include refid="Base_Column_List" />
        FROM xxx 
        WHERE id = #{id}
    </select>

    <!-- pageOfDetail 查询 -->
    <select id="pageOfDetail" resultMap="XxxDtoResultMap">
        SELECT 
        <include refid="Base_Column_List" />
        FROM xxx 
        <where>
            <if test="entity.name != null and entity.name != ''">
                AND name = #{entity.name}
            </if>
            <if test="entity.startTime != null">
                AND create_time &gt;= #{entity.startTime}
            </if>
            <if test="entity.endTime != null">
                AND create_time &lt;= #{entity.endTime}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>