<script setup lang="ts">
import { router, userInfo, useStore, t } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import CustomTabbar from "./components/tabbar.uvue";

const { user } = useStore();
const ui = useUi();

function toSet() {
	router.to("/pages/set/index");
}

function toEdit() {
	router.to("/pages/user/edit");
}

function toWechat() {
	ui.showToast({
		message: t("开发中，敬请期待")
	});
}

onReady(() => {
	user.get();
});
</script>

<style lang="scss" scoped>
.top-icon {
