<script lang="ts" setup>
import { isMp, router, useRefs, t } from "@/.cool";
import { reactive } from "vue";
import { useUi } from "@/uni_modules/cool-ui";
import { config } from "@/config";
import LocaleSet from "@/components/locale-set.uvue";
import SizeSet from "@/components/size-set.uvue";
import CustomTabbar from "./components/tabbar.uvue";

const ui = useUi();
const refs = useRefs();

type DeviceCount = {
	total: number;
	online: number;
	offline: number;
	alarm: number;
};

type QuickFunction = {
	key: string;
	label: string;
	icon: string;
};

// 设备统计（后续对接接口）
const deviceCount = reactive<DeviceCount>({
	total: 0,
	online: 0,
	offline: 0,
	alarm: 0
});

// 最新告警列表（后续对接接口）
const recentAlarms = reactive<any[]>([]);

// 快捷功能列表
const quickFunctions: QuickFunction[] = [
	{ key: "realTime", label: t("实时数据"), icon: "dashboard-line" },
	{ key: "collect", label: t("采集任务"), icon: "cloud-line" },
	{ key: "history", label: t("历史数据"), icon: "history-line" },
	{ key: "log", label: t("操作日志"), icon: "file-list-line" }
];

function toDevice() {
	router.to("/pages/index/device");
}

function toAlarm() {
	ui.showToast({
		message: t("开发中，敬请期待")
	});
}

function toStub() {
	ui.showToast({
		message: t("开发中，敬请期待")
	});
}

function setLocale() {
	refs.open("localeSet");
}

function setSize() {
	refs.open("sizeSet");
}
</script>

<style lang="scss" scoped></style>
