<template>
  <IvzBasicView #if(${cfg.moduleName})name="$!{cfg.moduleName}"#end #if(${cfg.rowKey})rowKey="$!{cfg.rowKey}"#end auth>
    <IvzViewSearch>
      #foreach($vue in ${cfg.vueFields})
        #if(${vue.searchComponent})
          ${vue.searchComponent}
        #end
      #end
      <template #func>
        <IvzFuncBtn func="reset">重置</IvzFuncBtn>
        <IvzFuncBtn func="query" url="#if(${package.ModuleName})/${package.ModuleName}#end/#if(${controllerMappingHyphenStyle})${controllerMappingHyphen}#else${table.entityPath}#end/view">搜索</IvzFuncBtn>
        <IvzFuncBtn func="add" url="#if(${package.ModuleName})/${package.ModuleName}#end/#if(${controllerMappingHyphenStyle})${controllerMappingHyphen}#else${table.entityPath}#end/add">新增</IvzFuncBtn>
      </template>
    </IvzViewSearch>
    <IvzViewModal width="860" layout="vertical" :rules="rules" placement="left">
      <template #default="{model}">
        <IvzRow :gutter="16" span="8">
          #foreach($vue in ${cfg.vueFields})
           #if(${vue.component})
            ${vue.component}
           #end
          #end
        </IvzRow>
      </template>
      <template #title="{model}">
        {{model.id != null ? '修改${cfg.moduleName}' : '新增${cfg.moduleName}'}}
      </template>
      <template #footer="{model}">
        <IvzFuncBtn func="cancel">取消</IvzFuncBtn>
        <IvzFuncBtn func="submit" :url="'#if(${package.ModuleName})/${package.ModuleName}#end/#if(${controllerMappingHyphenStyle})${controllerMappingHyphen}#else${table.entityPath}#end/save'">提交</IvzFuncBtn>
        <IvzFuncBtn func="reset">重置</IvzFuncBtn>
      </template>
    </IvzViewModal>
    <IvzViewTable :columns="columns" :bordered="true" size="small">
      <template #c_action="{record}">
        <IvzFuncTag func="edit" :data="record" url="#if(${package.ModuleName})/${package.ModuleName}#end/#if(${controllerMappingHyphenStyle})${controllerMappingHyphen}#else${table.entityPath}#end/detail">修改</IvzFuncTag>
        <IvzFuncTag func="del" :data="record" url="#if(${package.ModuleName})/${package.ModuleName}#end/#if(${controllerMappingHyphenStyle})${controllerMappingHyphen}#else${table.entityPath}#end/del">删除</IvzFuncTag>
      </template>
    </IvzViewTable>
  </IvzBasicView>
</template>

<script>
import {ref, reactive} from "vue";

export default {
  name: "Admin",
  setup() {
    let columns = ref([
        #foreach($field in ${cfg.vueFields})
          {field: "${field.field}", title: "${field.label}"},
        #end
          {title: '操作', field: 'action', type: 'action'},
      ]);

    let rules = reactive({
      #foreach($field in ${cfg.vueFields})
        #if(${field.required})
            ${field.field}: {required: true, message: '${field.label}必填'},
        #end
      #end
    })

    return {columns, rules}
  },
}
</script>

