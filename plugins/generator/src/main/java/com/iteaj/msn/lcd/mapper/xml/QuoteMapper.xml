<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.msn.lcd.mapper.QuoteMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.msn.lcd.entity.Quote">
        <result column="id" property="id" />
        <result column="test_name" property="testName" />
        <result column="pid" property="pid" />
    </resultMap>

    <!-- 详情查询映射结果 -->
    <resultMap id="DetailResultMap" type="com.iteaj.msn.lcd.dto.QuoteDto" extends="BaseResultMap">
        <result column="name" property="name" />
        <result column="price" property="price" />
    </resultMap>

    <!-- 获取详情分页记录 -->
    <select id="detailPage" resultMap="DetailResultMap">
        select a.*, b.name name, b.price price
        from t_quote a
            left join t_product b on a.pid=b.id
        <where>
            <if test="entity.testName!=null and entity.testName!=''">and a.test_name=#{entity.testName}</if>
            <if test="entity.name!=null and entity.name!=''">and b.name=#{entity.name}</if>
            <if test="entity.price != null">and b.price=#{entity.price}</if>
        </where>
    </select>

    <!-- 获取指定的详情记录 -->
    <select id="detailById" resultMap="DetailResultMap">
        select a.*, b.name name, b.price price
        from t_quote a
            left join t_product b on a.pid=b.id
        where a.id=#{id}
    </select>
</mapper>
