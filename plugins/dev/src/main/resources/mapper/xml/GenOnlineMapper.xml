<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.dev.mapper.IGenOnlineMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="OriMap" type="com.iteaj.dev.entity.GenOnline">
        <id column="id" property="id" />
        <result column="desc" property="desc" />
        <result column="html" property="html" />
        <result column="metas" property="metas" />
        <result column="name" property="name" />
        <result column="permMetas" property="permMetas" />
        <result column="view_config" property="viewConfig" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 表字段列表 -->
    <sql id="OriSql">
         a.create_time, a.id, a.update_time, a.desc, a.html, a.metas, a.name, a.permMetas, a.view_config
    </sql>
    <!-- 表字段关联列表 -->
    <sql id="OriJoinSql">
         goe.create_time goe_create_time, goe.id goe_id, goe.update_time goe_update_time, goe.desc goe_desc, goe.html goe_html, goe.metas goe_metas,
		 goe.name goe_name, goe.permMetas goe_permMetas, goe.view_config goe_view_config
    </sql>
</mapper>
