<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.plugin.iotview.mapper.ResourceMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.plugin.iotview.entity.Resource">
        <result column="id" property="id" />
        <result column="name" property="name" />
        <result column="url" property="url" />
        <result column="type" property="type" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <resultMap id="BaseTypeResultMap" type="com.iteaj.iboot.plugin.iotview.entity.ResourceType">
        <result column="id" property="id" />
        <result column="name" property="name" />
        <result column="type" property="type" />
        <collection property="resources" resultMap="BaseResultMap" foreignColumn="type" columnPrefix="t_" />
    </resultMap>

    <select id="listTypes" resultType="com.iteaj.iboot.plugin.iotview.entity.ResourceType">
        select * from isv_resource_type order by sort
    </select>

    <select id="details" resultMap="BaseTypeResultMap">
        select a.*, t.id t_id, t.name t_name, t.type t_type, t.url t_url from isv_resource_type a
            left join isv_resource t on a.type = t.type
        <where>
            <if test="type != null and type != ''">
                a.type=#{type}
            </if>
        </where>
    </select>

</mapper>
