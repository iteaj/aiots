<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.plugin.script.mapper.ScriptMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.plugin.script.entity.Script">
        <result column="id" property="id" />
        <result column="type" property="type" />
        <result column="name" property="name" />
        <result column="language" property="language" />
        <result column="script" property="script" typeHandler="com.iteaj.framework.mybatis.handler.FastjsonTypeHandler" />
        <result column="remark" property="remark" />
    </resultMap>

    <select id="isJoinModelApi" resultType="java.lang.Boolean">
        select count(id) > 0 from iot_model_api_config where value=concat('#', #{name}) limit 1
    </select>
    <select id="isJoinModelAttr" resultType="java.lang.Boolean">
        select count(id) > 0 from iot_model_attr where resolver=#{key} limit 1
    </select>

</mapper>
