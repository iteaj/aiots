<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.plugin.oauth2.mapper.Oauth2ClientMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.plugin.oauth2.entity.Oauth2ClientUser">
        <result column="id" property="id" />
        <result column="type" property="type" />
        <result column="account" property="account" />
        <result column="openid" property="openid" />
        <result column="nickname" property="nickname" />
        <result column="avatar_url" property="avatarUrl" />
        <result column="user_type" property="userType" />
    </resultMap>

    <insert id="insertSysAdmin">
        insert into sys_admin (name, org_id, post_id, account, email, phone, sex, avatar, password, status, remark, create_time, create_by) value
            (#{name},#{orgId}, #{postId}, #{account},#{email},#{phone},#{sex},#{avatar},#{password},#{status}, #{remark}, now(), 'oauth2');
        set @lastId=LAST_INSERT_ID();
        <if test="roles != null and roles.size() > 0">
            insert into sys_admin_role (aid, rid) values
            <foreach collection="roles" item="item" separator=",">
                (@lastId, #{item})
            </foreach>
        </if>
    </insert>


</mapper>
