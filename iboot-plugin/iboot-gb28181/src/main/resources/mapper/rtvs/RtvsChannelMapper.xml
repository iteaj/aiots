<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.plugin.gbs.rtvs.RtvsChannelMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BasicMap" type="com.iteaj.iboot.plugin.gbs.rtvs.RtvsChannel">
        <result column="ChannelID" property="channelId" />
        <result column="Model" property="model" />
        <result column="DeviceID" property="deviceId" />
        <result column="Name" property="name" />
        <result column="Port" property="port" />
        <result column="Owner" property="owner" />
        <result column="Online" property="status" />
        <result column="Block" property="block" />
        <result column="CertNum" property="certNum" />
        <result column="Address" property="address" />
        <result column="Password" property="password" />
        <result column="Secrecy" property="secrecy" />
        <result column="Parental" property="parental" />
        <result column="Longitude" property="longitude" />
        <result column="Latitude" property="latitude" />
        <result column="ErrCode" property="errCode" />
        <result column="EndTime" property="endTime" />
        <result column="CivilCode" property="civilCode" />
        <result column="ParentID" property="parentId" />
        <result column="IPAddress" property="ipAddress" />
        <result column="BusinessGroupID" property="businessGroupId" />
        <result column="SafetyWay" property="safetyWay" />
        <result column="NickName" property="nickName" />
        <result column="RegisterWay" property="registerWay" />
        <result column="Manufacturer" property="manufacture" />
        <result column="Certifiable" property="certifiable" />
        <result column="OfflineTime" property="updateTime" />
    </resultMap>

    <select id="listViewChannels" resultType="com.iteaj.iboot.plugin.gbs.dto.GbsViewChannelDto">
        select Name label, concat(DeviceID, '::',ChannelID) value from t_catalog
    </select>


</mapper>
