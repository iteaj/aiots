<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.iteaj</groupId>
        <artifactId>iboot</artifactId>
        <version>${reversion}</version>
    </parent>

    <packaging>pom</packaging>
    <name>iboot:plugin</name>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>iboot-plugin</artifactId>

    <modules>
        <!--代码生成器插件-->
        <module>iboot-code</module>
        <!--SaToken权限校验插件-->
        <module>iboot-SaToken</module>
        <!--SaToken Oauth2插件-->
        <module>iboot-oauth2</module>
        <!--quartz定时任务插件-->
        <module>iboot-quartz</module>
        <!--消息插件(Sms、Email、[...])-->
        <module>iboot-message</module>
        <!--文件管理插件-->
        <module>iboot-file</module>
        <!--物模型协议模块-->
        <module>iboot-protocol</module>
        <!--国标gb28181模块-->
        <module>iboot-gb28181</module>
        <module>iboot-amqp</module>
        <!--乐吾乐在线大屏(组态、3D)-->
        <module>iboot-le5le</module>
        <!--多数据源-->
        <module>iboot-datasource</module>
        <!--北向接入-->
        <module>iboot-open</module>
        <!--脚本插件-->
        <module>iboot-script</module>
        <!--大屏/组态插件-->
        <module>iboot-iotview</module>
        <module>iboot-edge</module>
        <!--ai模块-->
        <module>iboot-ai</module>
        <!--社交登录插件（微信、支付宝等）-->
        <module>iboot-social</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>com.iteaj</groupId>
            <artifactId>framework</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
