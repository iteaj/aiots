<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteaj.iboot.plugin.ai.mapper.AiDatasetMapper">

    <!-- 实体映射结果 -->
    <resultMap id="BaseResultMap" type="com.iteaj.iboot.plugin.ai.entity.AiDataset">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="config" column="config" typeHandler="com.iteaj.framework.mybatis.handler.FastjsonTypeHandler"/>
        <result property="recordCount" column="record_count"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- DTO 映射结果 -->
    <resultMap id="AiDatasetDtoResultMap" type="com.iteaj.iboot.plugin.ai.dto.AiDatasetDto" extends="BaseResultMap">
        <!-- 一对多关联：数据集明细列表 -->
        <collection property="items" column="id" columnPrefix="item_" 
                    ofType="com.iteaj.iboot.plugin.ai.entity.AiDatasetItem">
            <id property="id" column="id"/>
            <result property="datasetId" column="dataset_id"/>
            <result property="name" column="name"/>
            <result property="type" column="type"/>
            <result property="filePath" column="file_path"/>
            <result property="label" column="label"/>
            <result property="split" column="split"/>
            <result property="recordCount" column="record_count"/>
            <result property="sort" column="sort"/>
            <result property="config" column="config" typeHandler="com.iteaj.framework.mybatis.handler.FastjsonTypeHandler"/>
            <result property="createTime" column="create_time"/>
            <result property="updateTime" column="update_time"/>
        </collection>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        t.id, t.name, t.config, t.record_count, t.status, t.remark, t.create_time, t.update_time
    </sql>

    <!-- detailById 查询 -->
    <select id="detailById" resultMap="AiDatasetDtoResultMap">
        SELECT 
            t.id, t.name, t.config, t.record_count, t.remark, t.create_time, t.update_time,
            i.id AS item_id, i.dataset_id AS item_dataset_id, i.name AS item_name, i.type AS item_type,
            i.file_path AS item_file_path, i.label AS item_label, i.split AS item_split,
            i.record_count AS item_record_count, i.sort AS item_sort, i.config AS item_config,
            i.create_time AS item_create_time, i.update_time AS item_update_time
        FROM ai_dataset t
        LEFT JOIN ai_dataset_item i ON i.dataset_id = t.id
        WHERE t.id = #{id}
        ORDER BY i.sort ASC, i.create_time DESC
    </select>

    <!-- pageOfDetail 查询 -->
    <select id="pageOfDetail" resultMap="AiDatasetDtoResultMap">
        SELECT 
            t.id, t.name, t.config, t.record_count, t.status, t.remark, t.create_time, t.update_time
        FROM ai_dataset t
        <where>
            <if test="dto.name != null and dto.name != ''">
                AND t.name LIKE CONCAT('%', #{dto.name}, '%')
            </if>
            <if test="dto.startTime != null">
                AND t.create_time &gt;= #{dto.startTime}
            </if>
            <if test="dto.endTime != null">
                AND t.create_time &lt;= #{dto.endTime}
            </if>
        </where>
        ORDER BY t.create_time DESC
    </select>

</mapper>
